{%- comment -%}
  Phase 8. popover-polyfill.js is 25 KB and its own last line is
  `if (!isSupported()) apply();` — every browser with native popover support
  (Chrome 114+, Safari 17+, Firefox 125+) downloaded it on the critical path in
  order to do nothing. No other module imports it, so gating the fetch on the same
  feature check it performs internally is behaviour-preserving.
{%- endcomment -%}
<script>
  if (!Object.prototype.hasOwnProperty.call(HTMLElement.prototype, 'popover')) {
    var popoverPolyfill = document.createElement('script');
    popoverPolyfill.type = 'module';
    popoverPolyfill.fetchPriority = 'low';
    popoverPolyfill.src = "{{ 'popover-polyfill.js' | asset_url }}";
    document.head.appendChild(popoverPolyfill);
  }
</script>
