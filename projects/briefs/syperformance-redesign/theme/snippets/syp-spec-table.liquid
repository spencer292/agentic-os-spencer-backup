{%- doc -%}
  SYPerformance spec table — label/value rows with monospace, tabular values.

  Accepts either a metafield list of {label, value} objects, or a newline
  separated string of "Label: Value" pairs so it can be driven from a plain
  textarea before metafields exist.

  @param {object} rows - Array of {label, value} objects. A newline-separated
    "Label: Value" string is also accepted, so the table can be driven from a
    plain textarea before metafields exist.
  @param {string} [caption] - Small uppercase caption above the table

  @example
  {% render 'syp-spec-table', rows: product.metafields.custom.specs.value, caption: 'Specification' %}
{%- enddoc -%}

<table class="syp-spec-table">
  {%- if caption != blank -%}
    <caption>{{ caption }}</caption>
  {%- endif -%}
  <tbody>
    {%- if rows.size > 0 and rows.first.label -%}
      {%- for row in rows -%}
        <tr>
          <th scope="row">{{ row.label }}</th>
          <td>{{ row.value }}</td>
        </tr>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}
        newline_to_br rather than splitting on a newline literal: the literal is
        fragile across CRLF checkouts and silently collapses every row into one.
      {%- endcomment -%}
      {%- assign spec_lines = rows | newline_to_br | split: '<br />' -%}
      {%- for line in spec_lines -%}
        {%- assign parts = line | split: ':' -%}
        {%- if parts.size > 1 -%}
          <tr>
            <th scope="row">{{ parts[0] | strip }}</th>
            <td>{{ parts | slice: 1, parts.size | join: ':' | strip }}</td>
          </tr>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </tbody>
</table>
