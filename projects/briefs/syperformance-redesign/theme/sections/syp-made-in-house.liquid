{%- comment -%}
  SYPerformance — made in-house.

  The manufacturing story. Phase 0 found this "100% absent from the site", and
  it is the section that turns a reseller storefront into a manufacturer's.

  Structure is deliberately factual: a short statement, then process steps, then
  optional shop photography. Each step is a block so the story can be told in
  three moves or six without a redesign.

  Photography is optional throughout. A step with no image renders as a numbered
  text step, which is honest, rather than as a broken image well. When real shop
  photos exist they drop in and the layout absorbs them.

  Write the copy as what happens to the metal. Not "quality craftsmanship".
{%- endcomment -%}

{{ 'syp-components.css' | asset_url | stylesheet_tag }}
{{ 'syp-home.css' | asset_url | stylesheet_tag }}

<div class="syp-mih">
  <div class="syp-mih__inner">
    <header class="syp-mih__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="syp-label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="syp-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <div class="syp-mih__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </header>

    {%- assign steps = section.blocks | where: 'type', 'step' -%}
    {%- if steps.size > 0 -%}
      <ol class="syp-mih__steps">
        {%- for block in steps -%}
          <li class="syp-mih__step" {{ block.shopify_attributes }}>
            <span class="syp-mih__step-index syp-spec">
              {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
            </span>

            {%- if block.settings.image != blank -%}
              <div class="syp-mih__step-media">
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 900',
                    sizes: '(min-width: 990px) 30vw, 90vw',
                    alt: block.settings.image.alt | default: block.settings.title
                }}
              </div>
            {%- endif -%}

            <h3 class="syp-mih__step-title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="syp-mih__step-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="syp-mih__cta">
        {% render 'syp-button',
          label: section.settings.cta_label,
          href: section.settings.cta_url,
          variant: 'secondary'
        %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SYP made in-house",
  "tag": "section",
  "class": "syp-mih-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The manufacturing story. Write what happens to the metal, not adjectives. Steps work with or without photography."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made in-house" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We are a machine shop that sells parts, not a shop that buys them"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "info": "Two or three sentences. What is made here, on what, to what standard."
    },
    { "type": "text", "id": "cta_label", "label": "CTA", "default": "See the shop" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Real shop photography only." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SYP made in-house",
      "blocks": [
        { "type": "step", "settings": { "title": "Designed here" } },
        { "type": "step", "settings": { "title": "Machined here" } },
        { "type": "step", "settings": { "title": "Checked here" } }
      ]
    }
  ]
}
{% endschema %}
