{%- comment -%}
  SYPerformance — the manufacturing story.

  Phase 0 found this "100% absent from the site". It is what separates SY's own
  product line from the resold catalogue.

  COPY RULE (2026-08-26). SYPerformance IS the manufacturer: it owns the designs,
  the drawings and the specs, contracts production to them, inspects and stands
  behind the result. That is the standard meaning of the word and it is the
  authoritative claim — use it. What this section must NOT do is name a shop
  floor. No "machined in our own shop", no "cut here", no "our machines". An
  earlier draft did and it was false.

  Structure is deliberately factual: a short statement, then process steps, then
  optional shop photography. Each step is a block so the story can be told in
  three moves or six without a redesign.

  Photography is optional throughout. A step with no image renders as a numbered
  text step, which is honest, rather than as a broken image well. When real shop
  photos exist they drop in and the layout absorbs them.

  Write the copy as what SY actually decides and controls. Not "quality craftsmanship".
{%- endcomment -%}

{{ 'syp-components.css' | asset_url | stylesheet_tag }}
{{ 'syp-home.css' | asset_url | stylesheet_tag }}

<div class="syp-mih">
  <div class="syp-mih__inner">
    <header class="syp-mih__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="syp-label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="syp-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <div class="syp-mih__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </header>

    {%- assign steps = section.blocks | where: 'type', 'step' -%}
    {%- if steps.size > 0 -%}
      <ol class="syp-mih__steps">
        {%- for block in steps -%}
          <li class="syp-mih__step" {{ block.shopify_attributes }}>
            <span class="syp-mih__step-index syp-spec">
              {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
            </span>

            {%- if block.settings.image != blank -%}
              <div class="syp-mih__step-media">
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 900',
                    sizes: '(min-width: 990px) 30vw, 90vw',
                    alt: block.settings.image.alt | default: block.settings.title
                }}
              </div>
            {%- endif -%}

            <h3 class="syp-mih__step-title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="syp-mih__step-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="syp-mih__cta">
        {% render 'syp-button',
          label: section.settings.cta_label,
          href: section.settings.cta_url,
          variant: 'secondary'
        %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SYP design story",
  "tag": "section",
  "class": "syp-mih-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "SYPerformance is the manufacturer - own designs, own drawings, own spec. Say we manufacture, we make, our parts. Never name a facility: no \"machined in our own shop\" or \"cut here\"."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our own parts" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We manufacture our own parts. We don't rebadge someone else's."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "info": "Two or three sentences. What SYPerformance manufactures, and what owning the spec gets the customer."
    },
    { "type": "text", "id": "cta_label", "label": "CTA", "default": "About SYPerformance" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Real photography only - parts, drawings, inspection." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SYP design story",
      "blocks": [
        { "type": "step", "settings": { "title": "Designed against the failure" } },
        { "type": "step", "settings": { "title": "Built to our spec" } },
        { "type": "step", "settings": { "title": "Checked before it ships" } }
      ]
    }
  ]
}
{% endschema %}
