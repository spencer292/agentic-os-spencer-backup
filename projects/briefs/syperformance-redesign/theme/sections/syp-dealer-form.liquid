{%- comment -%}
  SYPerformance dealer / pro program application.

  DOC Race is resold by R44, 5150 AutoSport, Speed Logic and Patterson. Every
  one of those storefronts is shelf space and a backlink SY does not have, and
  this form is where that pipeline starts.

  Built on Shopify's native `form 'contact'` rather than an app: it posts to the
  store's contact email, needs no monthly bill and adds no third-party script.
  Extra fields are plain `contact[Label]` inputs, which Shopify passes straight
  through into the notification email.

  Qualifying questions are deliberate. The point is not to collect leads, it is
  to find shops that already build these platforms — so the form asks what they
  build and on what, not just for a name and an email.
{%- endcomment -%}

{{ 'syp-components.css' | asset_url | stylesheet_tag }}
{{ 'syp-pages.css' | asset_url | stylesheet_tag }}

{%- assign form_id = 'syp-dealer-form' -%}

<div class="syp-dform">
  <div class="syp-dform__inner">
    <div class="syp-dform__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="syp-label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="syp-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <div class="syp-dform__body rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- assign points = section.blocks | where: 'type', 'point' -%}
      {%- if points.size > 0 -%}
        <ul class="syp-dform__points">
          {%- for block in points -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="syp-dform__form-wrap">
      {%- form 'contact', id: form_id, class: 'syp-dform__form' -%}
        <input type="hidden" name="contact[Enquiry]" value="Dealer / pro program application">

        {%- if form.errors -%}
          <p class="syp-dform__message syp-dform__message--error" tabindex="-1" autofocus>
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- elsif form.posted_successfully? -%}
          <p class="syp-dform__message" tabindex="-1" autofocus>{{ section.settings.success }}</p>
        {%- endif -%}

        <div class="syp-dform__grid">
          <p class="syp-dform__field">
            <label class="syp-label" for="{{ form_id }}-shop">Shop or business name</label>
            <input id="{{ form_id }}-shop" type="text" name="contact[Shop]" autocomplete="organization" required>
          </p>

          <p class="syp-dform__field">
            <label class="syp-label" for="{{ form_id }}-name">Your name</label>
            <input id="{{ form_id }}-name" type="text" name="contact[Name]" autocomplete="name" required>
          </p>

          <p class="syp-dform__field">
            <label class="syp-label" for="{{ form_id }}-email">Email</label>
            <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" required>
          </p>

          <p class="syp-dform__field">
            <label class="syp-label" for="{{ form_id }}-phone">Phone</label>
            <input id="{{ form_id }}-phone" type="tel" name="contact[Phone]" autocomplete="tel">
          </p>

          <p class="syp-dform__field">
            <label class="syp-label" for="{{ form_id }}-location">City / state</label>
            <input id="{{ form_id }}-location" type="text" name="contact[Location]" autocomplete="address-level2">
          </p>

          <p class="syp-dform__field">
            <label class="syp-label" for="{{ form_id }}-site">Website or Instagram</label>
            <input id="{{ form_id }}-site" type="text" name="contact[Website]">
          </p>

          {%- comment -%}
            The qualifying question. A shop that builds K-series AWD cars is a
            different conversation from one that fits exhausts, and the answer
            here decides which conversation Spencer has.
          {%- endcomment -%}
          <p class="syp-dform__field syp-dform__field--wide">
            <label class="syp-label" for="{{ form_id }}-builds">What do you build?</label>
            <textarea id="{{ form_id }}-builds" name="contact[What they build]" rows="4" required></textarea>
            <span class="syp-dform__hint">Platforms, typical power level, and roughly how many builds a year.</span>
          </p>

          <p class="syp-dform__field syp-dform__field--wide">
            <label class="syp-label" for="{{ form_id }}-parts">Which parts are you interested in stocking?</label>
            <textarea id="{{ form_id }}-parts" name="contact[Parts of interest]" rows="3"></textarea>
          </p>
        </div>

        {% render 'syp-button', label: section.settings.submit_label, variant: 'primary', type: 'submit' %}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SYP dealer form",
  "tag": "section",
  "class": "syp-dform-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Posts to the store contact email via Shopify's native form - no app, no monthly bill, no third-party script. Test it delivers before launch."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dealer & pro program" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apply to stock SYP parts" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "info": "Who this is for. Do not state discount levels or terms that are not agreed."
    },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Send application" },
    {
      "type": "text",
      "id": "success",
      "label": "Success message",
      "default": "Got it. We'll come back to you."
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "limit": 5,
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    }
  ],
  "presets": [{ "name": "SYP dealer form" }]
}
{% endschema %}
