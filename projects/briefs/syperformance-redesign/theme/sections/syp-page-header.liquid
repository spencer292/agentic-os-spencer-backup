{%- comment -%}
  SYPerformance page header.

  Used at the top of every Phase 6 trust page — About / Shop Tour, Warranty,
  Lead Times, Dealer Program, Build Gallery. Same shape as the collection
  header so the site reads as one system: eyebrow, H1, intro at a controlled
  measure, then a hairline and an optional fact strip.

  Falls back to the page's own title and content when the section settings are
  blank, so a page created from a runbook is never headless.
{%- endcomment -%}

{{ 'syp-components.css' | asset_url | stylesheet_tag }}
{{ 'syp-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign intro = section.settings.intro
  assign facts = section.blocks | where: 'type', 'fact'
-%}

<div class="syp-page-header">
  <div class="syp-page-header__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="syp-label">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="syp-page-header__title">{{ heading }}</h1>

    {%- if intro != blank -%}
      <div class="syp-page-header__intro rte">{{ intro }}</div>
    {%- endif -%}

    {%- if facts.size > 0 -%}
      <dl class="syp-page-header__facts">
        {%- for block in facts -%}
          <div class="syp-page-header__fact" {{ block.shopify_attributes }}>
            <dt class="syp-label">{{ block.settings.label }}</dt>
            <dd class="syp-spec">{{ block.settings.value }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SYP page header",
  "tag": "section",
  "class": "syp-page-header-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title." },
    { "type": "richtext", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value", "info": "Keep it literal. No claims that are not true today." }
      ]
    }
  ],
  "presets": [{ "name": "SYP page header" }]
}
{% endschema %}
