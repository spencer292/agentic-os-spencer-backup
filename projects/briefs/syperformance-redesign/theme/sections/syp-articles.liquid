{%- comment -%}
  SYPerformance — tech articles.

  Phase 0 found one blog with zero articles published. Phase 7 lists eight
  article targets that are real searches with weak competition — why K-series
  halfshafts fail above a given power level, single lobe rocker conversion,
  K-series synchro failure, top mount versus forward facing, and so on.

  Until those exist this section renders NOTHING. A "Latest from the blog"
  heading over an empty row tells a visitor the company has nothing to say.
{%- endcomment -%}

{{ 'syp-components.css' | asset_url | stylesheet_tag }}
{{ 'syp-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign blog = blogs[section.settings.blog]
  assign count = section.settings.count
-%}

{%- if blog.articles_count > 0 -%}
  <div class="syp-articles">
    <div class="syp-articles__inner">
      <header class="syp-articles__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="syp-label">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="syp-section-title">{{ section.settings.heading }}</h2>
        </div>
        <a class="syp-articles__all syp-spec" href="{{ blog.url }}">All articles &rarr;</a>
      </header>

      <ul class="syp-articles__list">
        {%- for article in blog.articles limit: count -%}
          <li class="syp-articles__item">
            <a class="syp-articles__card" href="{{ article.url }}">
              {%- if article.image -%}
                <span class="syp-articles__media">
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 500, 800',
                      sizes: '(min-width: 990px) 30vw, 90vw',
                      alt: ''
                  }}
                </span>
              {%- endif -%}
              <span class="syp-articles__date syp-spec">{{ article.published_at | date: '%b %d, %Y' }}</span>
              <span class="syp-articles__title">{{ article.title }}</span>
              {%- if article.excerpt_or_content != blank -%}
                <span class="syp-articles__excerpt">
                  {{- article.excerpt_or_content | strip_html | truncate: 140 -}}
                </span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <p class="syp-articles__pending syp-spec">
    Blog "{{ section.settings.blog }}" has no articles, so this section is hidden on the storefront.
    Phase 7 lists the first eight targets.
  </p>
{%- endif -%}

{% schema %}
{
  "name": "SYP articles",
  "tag": "section",
  "class": "syp-articles-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Hidden entirely until the blog has at least one article. A heading over an empty row says the company has nothing to say."
    },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tech" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How this stuff actually fails" },
    { "type": "range", "id": "count", "label": "Articles", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "SYP articles" }]
}
{% endschema %}
