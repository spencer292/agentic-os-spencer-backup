      "id": "f0e0ef16-d6cc-47fe-92da-7b4bc1f86695",
      "name": "Jobber Visits loader",
      "credentials": {
        "oAuth2Api": {
          "id": "MNPCi55yYggze27I",
          "name": "Jobber OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// --- pull the two upstream payloads ---\nconst routes = $('OptimoRoute get_routes').first().json.routes || [];\nconst visits = [\n  ...($('Jobber Visits loader').first().json.data.visits.nodes || []),\n  ...($('Jobber Visits loader p2').first().json.data.visits.nodes || [])\n];\n\n// --- jobNumber -> visitId dictionary (String-cast BOTH sides) ---\nconst visitByJob = {};\nfor (const v of visits) {\n  const jn = v.job && v.job.jobNumber;\n  if (jn !== undefined && jn !== null) {\n    visitByJob[String(jn)] = v.id;\n  }\n}\n\n// --- tech name -> Jobber encoded user id (match on last name) ---\nfunction mapTech(name) {\n  if (!name) return null;\n  if (name.includes('Ventura'))   return 'Z2lkOi8vSm9iYmVyL1VzZXIvMTI5NDM3Mg==';\n  if (name.includes('Anderson'))  return 'Z2lkOi8vSm9iYmVyL1VzZXIvNDA2MDE5OQ==';\n  if (name.includes('LaVergne'))  return 'Z2lkOi8vSm9iYmVyL1VzZXIvMzc3NDU2OA==';\n  if (name.includes('Hill'))      return 'Z2lkOi8vSm9iYmVyL1VzZXIvMzgwNjE2';\n  if (name.includes('Alexander')) return 'Z2lkOi8vSm9iYmVyL1VzZXIvMzE0NDEwNQ==';\n  return null;\n}\n\nconst out = [];\nfor (const route of routes) {\n  const driverName = route.driverName || '';\n  const jobberUserId = mapTech(driverName);\n  for (const stop of (route.stops || [])) {\n    const visitId = visitByJob[String(stop.orderNo)] || null;\n    // scheduledAtDt looks like \"2026-06-26 07:15:24\" (local Pacific)\n    const dt = stop.scheduledAtDt;\n    let startDate = null, startTime = null, endDate = null, endTime = null;\n    if (dt) {\n      const parsed = DateTime.fromFormat(dt, 'yyyy-MM-dd HH:mm:ss');\n      const end = parsed.plus({ hours: 3 }); // 3-hour customer window\n      startDate = parsed.toFormat('yyyy-MM-dd');\n      startTime = parsed.toFormat('HH:mm:ss');\n      endDate   = end.toFormat('yyyy-MM-dd');\n      endTime   = end.toFormat('HH:mm:ss');\n    }\n    // build the two GraphQL mutation strings here (no escaping headaches downstream)\n    const scheduleMutation = visitId ? JSON.stringify(\n      `mutation { visitEditSchedule(id: \"${visitId}\", input: { ` +\n      `startAt: { date: \"${startDate}\", time: \"${startTime}\", timezone: \"America/Los_Angeles\" }, ` +\n      `endAt: { date: \"${endDate}\", time: \"${endTime}\", timezone: \"America/Los_Angeles\" } }) ` +\n      `{ visit { id startAt endAt } userErrors { message } } }`\n    ) : null;\n    const assignMutation = (visitId && jobberUserId) ? JSON.stringify(\n      `mutation { visitEditAssignedUsers(visitId: \"${visitId}\", input: { ` +\n      `assignedUserIds: [\"${jobberUserId}\"] }) ` +\n      `{ visit { id assignedUsers { nodes { name { full } } } } userErrors { message } } }`\n    ) : null;\n    out.push({\n      json: {\n        orderNo: stop.orderNo,\n        driverName,\n        jobberUserId,\n        visitId,\n        startDate, startTime, endDate, endTime,\n        scheduleMutation,\n        assignMutation\n      }\n    });\n  }\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
