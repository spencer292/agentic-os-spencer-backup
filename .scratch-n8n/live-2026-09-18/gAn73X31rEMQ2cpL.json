        "jsonBody": "={{ JSON.stringify({ query: `query($cursor: String) { visits(first: 100, after: $cursor, filter: { startAt: { after: \"${$('Compute Date').item.json.runDate}T07:00:00Z\", before: \"${DateTime.fromISO($('Compute Date').item.json.runDate).plus({days:1}).toFormat('yyyy-MM-dd')}T07:00:00Z\" } }) { nodes { id startAt job { jobNumber } } pageInfo { hasNextPage endCursor } } }`, variables: { cursor: null } }) }}",
